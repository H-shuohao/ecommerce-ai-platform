# API authentication. Keep disabled for local demos; enable it in deployed environments.
API_AUTH_ENABLED=false
API_VIEWER_KEY=
API_SERVICE_KEY=
API_ADMIN_KEY=
JWT_AUTH_ENABLED=false
JWT_SECRET=
JWT_ISSUER=ecommerce-ai-platform
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7
AUTH_USERS_JSON=[]
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=256
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
ASSET_STORAGE_DIR=./data/assets
ASSET_MAX_UPLOAD_MB=50
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=120
LIVE_CLIP_MAX_DURATION_SECONDS=300
METRIC_ALERT_MINIMUM_SAMPLES=20
METRIC_ALERT_P95_WARNING_MS=3000
METRIC_ALERT_P95_CRITICAL_MS=5000
METRIC_ALERT_ERROR_RATE_WARNING_PERCENT=1
METRIC_ALERT_ERROR_RATE_CRITICAL_PERCENT=5
METRIC_ALERT_IN_FLIGHT_WARNING=20
METRIC_ALERT_IN_FLIGHT_CRITICAL=50

# Volcano account credentials. Keep real values only in .env.
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# Ark model call used by our custom RAG callback.
ARK_API_KEY=
ARK_ENDPOINT_ID=

# RTC room info returned to the frontend.
RTC_APP_ID=
RTC_APP_KEY=
RTC_ROOM_ID=ChatRoom01
RTC_USER_ID=Huoshan01
RTC_TOKEN=

# Voice chat task and agent identity.
VOICE_CHAT_TASK_ID=ChatTask01
AGENT_USER_ID=ChatBot01
AGENT_WELCOME_MESSAGE=你好，我是小懒，有什么需要帮忙的吗？

# ASR/TTS app ids.
ASR_APP_ID=
TTS_APP_ID=

# Public URL that Volcano RTC can call back, for example an ngrok URL.
SERVER_URL=

# Volcano Knowledge Base config.
VOLC_ACCOUNT_ID=
KB_PROJECT_NAME=default
KB_COLLECTION_NAME=dw_ai

# Low-score chunks are omitted from the LLM prompt, but the LLM still answers normally.
KB_MIN_RELEVANCE_SCORE=0.22
KB_MAX_CONTEXT_CHARS=500
